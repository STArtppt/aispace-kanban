# API key 等本地配置，绝对不能入库（.env.example 是模板，可以入库）
.env
.env.local

# Claude Code 本机设置：里面有新建时生成的「禁止改看板源码」规则，写的是本机绝对路径
.claude/settings.local.json

.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
__pycache__/
*.pyc
.venv/
venv/

# ---- 视觉平面 visualization/：整目录不入库，只留两个占位 ----
# references/ 是收下来的整页 HTML（内联资源后单份可达几十 MB），prototypes/ 是原型工具的构建产物和依赖。
# 体积大、可重新收取或构建，跟着本机走；看板读的是本地目录，不受影响。
visualization/*
!visualization/references/
!visualization/prototypes/
visualization/references/*
!visualization/references/.gitkeep
visualization/prototypes/*
!visualization/prototypes/.gitkeep

# Office 编辑时产生的锁文件
~$*
.~lock.*
.~*

# skill-creator 跑评测产生的工作区
*-workspace/

# ---- input/：原件、图片、数据源配置整目录不入库 ----
# 原件常常涉密、体积大；图片由转换脚本从原件抽出，重跑即可重建；
# input/sources/*.yaml 是数据源连接形状，跟着本机环境走。只留占位和两份说明。
# input/INDEX.md、input/README.md、input/.ingestignore 继续入库（不在下面三个目录里）。
input/raw/*
!input/raw/.gitkeep
input/assets/*
!input/assets/.gitkeep
input/sources/*
!input/sources/README.md
!input/sources/example.yaml.txt

# ---- Office 文档与 PDF：不管在哪个目录，一律不入库 ----
# 原件、交付稿 Word、交底包 xlsx、汇报 pptx、Word 模板包里的 reference.docx 都算。
# 它们是二进制，git 里看不出改了什么，还常常涉密；版本靠交付稿目录的 v001/v002 留存，本地文件不受影响。
*.doc
*.docx
*.xls
*.xlsx
*.xlsm
*.ppt
*.pptx
*.pdf

# ---- 大体积表格 / 数据产物：output/converted/ 下一律不入库 ----
# output/converted/ 是脚本产物（拆表 csv、点表 / 现场数据 sqlite），重跑 ingest.py / realdata.py / pointtable.py 即可重建；
# 普通 .md 产物与 _manifest_*.md 摘要仍入库（看板和 AI 靠它了解全局）。
# output/ 其余目录下的 SQL 配置件、核对件 csv 是手工交付物，**继续入库**保留版本历史。
output/converted/**/*.csv
output/converted/**/*.tsv
output/converted/**/*.sqlite
output/converted/**/*.sqlite-*
output/converted/**/*.db
output/converted/**/*.sql
output/converted/**/*.zip

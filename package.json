{
  "name": "aispace-kanban",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "AI 协作工作空间看板 —— 常驻服务，指向工作空间目录，只读展示概览、输入资料、输出产物与原型入口",
  "bin": {
    "aispace-kanban": "./bin/cli.mjs"
  },
  "scripts": {
    "dev": "node bin/cli.mjs serve --dev",
    "dev:app": "vite",
    "serve": "node bin/cli.mjs serve",
    "build": "vite build",
    "build:npm": "pnpm build && node scripts/build-npm-package.mjs",
    "pack:npm": "cd npm-package && npm pack",
    "smoke:npm": "node scripts/smoke-package.mjs",
    "typecheck": "tsc --noEmit",
    "test:anchor": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/test-anchor.ts",
    "test:rich-doc": "node scripts/check-rich-doc.mjs",
    "test:questions": "node scripts/check-questions.mjs",
    "test:docx": "node scripts/check-docx.mjs",
    "test:template-update": "node scripts/check-template-update.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@firecrawl/anydoc": "^0.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "docx-preview": "^0.4.1",
    "katex": "^0.18.7",
    "lucide-react": "^0.525.0",
    "mermaid": "^11.16.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "xlsx": "0.18.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "shadcn": "^3.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}

# 复制本文件为 .env 并填入真实值。.env 已在 .gitignore 里，不会入库。
#
#   cp .env.example .env
#
# MinerU 在线解析 API。PDF 默认走本地 anydoc，不填也能用。
# MinerU 只在扫描件、要抽图、复杂版式时才需要（--pdf-engine mineru，或扫描件自动升级 OCR）。
# Token 在 https://mineru.net/apiManage 创建，注意有效期，过期后重新生成。
MINERU_API_KEY=

# 可选：MinerU 默认识别语言。ch=中英混排（默认），其他见官方语言包列表
# MINERU_LANGUAGE=ch

# 可选：指定本地 anydoc 的位置（PDF / .doc / .ppt 靠它在本机转换，不联网、不外发）。
#
# **正常情况下不用填。** 看板点「转换」会注入自带的那份；在终端里自己跑
# scripts/ingest.py 时，脚本会去读看板启动时记在 ~/.pmwork/dashboard/runtime.json
# 里的路径 —— 起过一次看板就有了。再不行还会找 PATH（npm i -g @firecrawl/anydoc）。
#
# 只有这几种情况才需要手填：不跑看板的机器、CI、或者想钉住某个特定版本。
#   node -e "console.log(require.resolve('@firecrawl/anydoc/cli.js'))"
# ANYDOC_BIN=

{
  "name": "aispace-kanban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "PM 工作空间看板 —— 常驻服务，指向 pmwork 工作空间目录，只读展示项目概览、输入资料、输出产物与原型入口",
  "bin": {
    "aispace-kanban": "./bin/cli.mjs"
  },
  "scripts": {
    "dev": "node bin/cli.mjs serve --dev",
    "dev:app": "vite",
    "serve": "node bin/cli.mjs serve",
    "build": "vite build",
    "build:npm": "pnpm build && node scripts/build-npm-package.mjs",
    "pack:npm": "cd npm-package && npm pack",
    "smoke:npm": "node scripts/smoke-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "shadcn": "^3.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}

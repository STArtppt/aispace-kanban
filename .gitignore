node_modules/
dist/
# npm 组包暂存目录（scripts/build-npm-package.mjs 每次重建）
npm-package/
*.tgz
.DS_Store
*.local
.env

# templates/ 里是空骨架，不带任何示例内容 —— 新建工作空间从选中的模板铺出来，
# 带了示例就会跟着复制过去。完整示例改成 Releases 里的 zip 单独发。
# 下面是防呆：本地往模板里丢资料试脚本时，别顺手提交进来。
templates/*/input/raw/*
!templates/*/input/raw/.gitkeep
templates/*/input/assets/*
!templates/*/input/assets/.gitkeep

# 打给 Releases 的产物 + 示例资料原件（含真实截图，不入库）
release/

# 私有资料（不入库，如 docs/private 的发布与CI笔记）
private/

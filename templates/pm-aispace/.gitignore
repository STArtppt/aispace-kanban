# API key 等本地配置，绝对不能入库（.env.example 是模板，可以入库）
.env
.env.local

# Claude Code 本机设置：里面有新建时生成的「禁止改看板源码」规则，写的是本机绝对路径
.claude/settings.local.json

.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
__pycache__/
*.pyc
.venv/
venv/

# 视觉平面 visualization/：references/ 收下来的页面、prototypes/ 工具产出的原型。
#
# 原型工具会在包目录里留下依赖和中间产物，这些一律不入库。
# 原型包本身（已构建的 index.html + 资源）是否入库看你的需要——
# 不想让生成内容进版本库就整体忽略 visualization/prototypes/（保留 .gitkeep 以便目录还在）。
visualization/prototypes/**/node_modules/
visualization/prototypes/**/.axhub-cache/
visualization/prototypes/**/dist/
visualization/prototypes/**/.cache/

# 参考页**默认入库**：一份参考是整页 HTML + 几张截图，单份几 MB 到十几 MB。
# 它是项目的一手资料（当时的那个页面，之后可能就改了或没了），
# 值这个体积，也应该跟着工作空间一起被拷走、被 AI 找到。
# 仓库体积吃紧时再取消下面这行的注释，改成只留在本地。
# visualization/references/

# Office 编辑时产生的锁文件
~$*
.~lock.*
.~*

# skill-creator 跑评测产生的工作区
*-workspace/

# ---- input/：原件、图片、数据源配置整目录不入库 ----
# 原件常常涉密、体积大；图片由转换脚本从原件抽出，重跑即可重建；
# input/sources/*.yaml 是数据源连接形状，跟着本机环境走。只留占位和两份说明。
# input/INDEX.md、input/README.md、input/.ingestignore 继续入库（不在下面三个目录里）。
input/raw/*
!input/raw/.gitkeep
input/assets/*
!input/assets/.gitkeep
input/sources/*
!input/sources/README.md
!input/sources/example.yaml.txt

# ---- 大体积二进制 / 表格产物：output/converted/ 与 visualization/ 下一律不入库 ----
# output/converted/ 是脚本产物（拆表 csv、点表 / 现场数据 sqlite），重跑 ingest.py / realdata.py / pointtable.py 即可重建；
# 普通 .md 产物与 _manifest_*.md 摘要仍入库（看板和 AI 靠它了解全局）。
# output/ 其余目录下的交底包 xlsx / SQL 配置件 / 核对件 csv 是手工交付物，**继续入库**保留版本历史。
# visualization/ 只入库 html / meta.json；原型 zip 和参考页截图留本地（覆盖上文「参考页默认入库」的截图部分）。
output/converted/**/*.csv
output/converted/**/*.tsv
output/converted/**/*.sqlite
output/converted/**/*.sqlite-*
output/converted/**/*.db
output/converted/**/*.sql
output/converted/**/*.docx
output/converted/**/*.doc
output/converted/**/*.pptx
output/converted/**/*.ppt
output/converted/**/*.xlsx
output/converted/**/*.xlsm
output/converted/**/*.xls
output/converted/**/*.pdf
output/converted/**/*.zip
visualization/**/*.zip
visualization/**/*.png
visualization/**/*.jpg
visualization/**/*.jpeg
visualization/**/*.gif
visualization/**/*.webp
visualization/**/*.tif
visualization/**/*.tiff
visualization/**/*.emf
visualization/**/*.wmf
visualization/**/*.docx
visualization/**/*.pptx
visualization/**/*.xlsx
